# ---------------------------------------------------------------------------
# Parallax environment configuration
#
# Every value below is OPTIONAL in development. When a key is absent the app
# falls back to the deterministic mock data provider (see src/lib/api), so the
# full interface is previewable with zero configuration. Populate these to wire
# in live data with no code changes beyond selecting the provider in
# src/lib/api/index.ts.
# ---------------------------------------------------------------------------

# Selects the market-data provider used by the data-access layer.
# Supported: "mock" (default) | "finnhub" | "fmp" | "polygon"
DATA_PROVIDER=mock

# --- Market / fundamentals data ---
FINANCIAL_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- News ---
NEWS_API_KEY=

# --- AI (server-side only; never exposed to the client) ---
# If ANTHROPIC_API_KEY is set, AI chat + forecasts call the live model.
# Otherwise a deterministic local synthesiser produces structured output so the
# AI surfaces remain fully functional in development.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=

# --- Persistence (Phase 2: watchlists / AI history / alerts) ---
# In Phase 1 the watchlist is stored client-side (localStorage). The schema in
# src/lib/db/schema.sql targets Postgres/Supabase for server-side persistence.
DATABASE_URL=
