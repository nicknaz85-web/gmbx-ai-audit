{
  "name": "party-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PARTY RADAR / Clubbit — live crowd intelligence for nightlife. Zero-dependency Node backend + web frontend, packaged for iOS/Android with Capacitor.",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:ios": "cap sync ios && cap open ios",
    "cap:android": "cap sync android && cap open android",
    "cap:icons": "capacitor-assets generate --iconBackgroundColor #120a22 --splashBackgroundColor #120a22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.5.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
