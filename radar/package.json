{
  "name": "party-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PARTY RADAR / Clubbit — live crowd intelligence for nightlife. Zero-dependency Node backend + web frontend, packaged for iOS/Android with Capacitor.",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:ios": "cap sync ios && cap open ios",
    "cap:android": "cap sync android && cap open android",
    "cap:icons": "capacitor-assets generate --iconBackgroundColor #120a22 --splashBackgroundColor #120a22"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0"
  }
}
