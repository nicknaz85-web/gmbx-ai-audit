<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Under edge-to-edge the WebView draws to the screen edges; any inset region
             it doesn't paint shows this (dark) instead of the white launch splash. -->
        <item name="android:windowBackground">@color/app_bg</item>
    </style>


    <!-- Launch theme: NO native OS splash (the app has its own HTML splash). Under
         Android edge-to-edge the OS splash surface was lingering in the status-bar
         inset as a band, so we drop Theme.SplashScreen entirely and just show a
         solid dark window background that flows straight into the WebView. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:background">@color/app_bg</item>
    </style>
</resources>